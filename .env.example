# URL pública HTTPS donde estará publicada la landing, sin barra final.
# En desarrollo puede usarse http://localhost:3001, pero Mercado Pago no podrá
# enviar webhooks hasta que uses una URL HTTPS pública o un túnel de pruebas.
PUBLIC_URL=https://metodoentrevista.store
HOST=127.0.0.1
PORT=3001

# Credenciales privadas de la aplicación creada en Mercado Pago Developers.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Correo que enviará los ebooks. Para Gmail usá una contraseña de aplicación,
# nunca la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=valeriafursten@gmail.com
SMTP_PASS=
SMTP_FROM=Método Entrevista <valeriafursten@gmail.com>

# Opción recomendada: una carpeta con los seis PDF y permiso
# "Cualquier persona con el enlace: lector".
EBOOK_FOLDER_URL=

# Alternativa: enlaces individuales. Solo son necesarios si EBOOK_FOLDER_URL
# está vacío.
EBOOK_METODO_URL=
EBOOK_CV_URL=
EBOOK_IA_URL=
EBOOK_LINKEDIN_URL=
EBOOK_EMPLEOS_URL=
EBOOK_ENTREVISTAS_URL=
